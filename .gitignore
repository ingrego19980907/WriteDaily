
# ==========================================
# WriteDaily — Git Ignore
# ==========================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js dependencies
node_modules/

# Frontend build output
dist/
dist-ssr/

# Tauri / Rust build artifacts
/src-tauri/target/
**/*.rs.bk

# Local environment configuration
.env
.env.*
*.local
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Tool caches and incremental compilation
.vite/
.vitest/
.cache/
.eslintcache
.prettiercache
*.tsbuildinfo

# Tests and coverage
coverage/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Local SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Temporary and backup files
*.tmp
*.temp
*.bak
*.sw?
*~

# IDE configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
